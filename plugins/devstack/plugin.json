	"license": "MIT",
	"keywords": [
		"workflow",
		"planning",
		"code-review",
		"pull-requests",
		"agents"
	],
	"extensions": {
		"superset": {
			"interface": {
				"displayName": "devstack",
				"category": "Developer tools",
				"icon": "./assets/icon.svg"
			}
		}
	}
