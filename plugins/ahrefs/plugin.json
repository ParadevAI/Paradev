{
	"$schema": "https://superset.sh/schemas/plugin/1.0.0.json",
	"name": "ahrefs",
	"version": "1.0.0",
	"description": "Research SEO with Ahrefs: backlinks, organic keywords, rankings, site audits, and brand visibility in AI search.",
	"author": {
		"name": "Paradev",
		"url": "https://paradev.com"
	},
	"homepage": "https://docs.paradev.com",
	"repository": "https://github.com/paradevai/paradev",
	"license": "MIT",
	"keywords": ["ahrefs", "seo", "backlinks", "keywords", "rank-tracking"],
	"extensions": {
		"superset": {
			"interface": {
				"displayName": "Ahrefs",
				"category": "Data & APIs",
				"icon": "ahrefs"
			},
			"connector": {
				"slug": "ahrefs_mcp"
			},
			"bind": {
				"headers": {
					"Authorization": "Bearer ${config.access_token}"
				}
			},
			"mcp": {
				"type": "streamable-http",
				"url": "https://api.ahrefs.com/mcp/mcp"
			}
		}
	}
}
