#!/usr/bin/env bash
# Spike prototype. The workspace's root is an overlay: the box's own disk (the
# golden) is the read-only lower, the workspace drive holds the upper.
#
#   superset-overlay-root enter CMD...   as root, outside: mount, pivot, exec CMD inside
#   superset-overlay-root run CMD...     as root, outside: run CMD in the live namespace
#   superset-overlay-root status         prints "live" when the namespace exists
set -euo pipefail

DRIVE="${SUPERSET_DRIVE_DIR:-/mnt/superset-drive}"
STATE=/var/lib/superset-ovl
MERGED="${STATE}/root"
LOWER="${STATE}/lower"
UPPER_HOME="${STATE}/u"
# Kernel 6.18 hands out mount namespace ids out of order, so binding a namespace
# to a file is refused at random (the loop check compares ids); a process is the handle.
HOLDER="${SUPERSET_OVERLAY_HOLDER:-/run/superset-ovl.pid}"
OPTS="${SUPERSET_OVERLAY_OPTS:-redirect_dir=on,index=on,metacopy=on,xino=auto}"

holder() {
	local pid
	pid="$(cat "$HOLDER" 2>/dev/null)" || return 1
	[ -n "$pid" ] && [ "$(nsenter --target "$pid" --mount findmnt -no FSTYPE / 2>/dev/null)" = overlay ] || return 1
	printf '%s' "$pid"
}

platform_files() {
	local bundle="${SUPERSET_BUNDLE_ROOT:-/opt/superset/bundle}/current" dest
	[ -f "${bundle}/tools.tsv" ] || return 0
	cut -f4 "${bundle}/tools.tsv" | while read -r dest; do
		dest="$(printf '%s' "$dest" | base64 --decode)"
		case "$dest" in /home/* | /workspace/*) continue ;; esac
		printf '%s\n' "$dest" "${dest}.hash"
	done
}

# Platform paths always come from the lower: before the overlay is mounted, drop
# whatever in the upper would hide them (a copy, a whiteout, an opaque parent).
scrub_upper() {
	{ printf '%s\n' /opt/superset /usr/local/share/superset /etc/superset; platform_files; } | python3 -I -c '
import os, shutil, sys
upper = sys.argv[1]
for path in filter(None, sys.stdin.read().split("\n")):
    target = upper + path
    if os.path.isdir(target) and not os.path.islink(target): shutil.rmtree(target)
    elif os.path.lexists(target): os.unlink(target)
    d = os.path.dirname(path)
    while d != "/":
        try: os.removexattr(upper + d, "trusted.overlay.opaque")
        except OSError: pass
        d = os.path.dirname(d)' "$1"
}

inner() {
	mount --make-rslave /
	mkdir -p "$LOWER" "$MERGED" "$UPPER_HOME" /var/log/superset
	mount --bind / "$LOWER"
	mount -o remount,bind,ro "$LOWER"
	mount --bind "${DRIVE}/overlay" "$UPPER_HOME"
	mount -t overlay overlay -o "lowerdir=${LOWER},upperdir=${UPPER_HOME}/upper,workdir=${UPPER_HOME}/work,${OPTS}" "$MERGED"

	local target
	while read -r target; do
		case "$target" in
			/ | "$STATE" | "$STATE"/* | "$DRIVE" | "$DRIVE"/* | /run | /run/* | /tmp) continue ;;
		esac
		[ -e "${MERGED}${target}" ] || { [ -d "$target" ] && mkdir -p "${MERGED}${target}" || : > "${MERGED}${target}"; }
		mount --bind "$target" "${MERGED}${target}"
		findmnt -no OPTIONS "$target" | grep -qE '(^|,)ro(,|$)' && mount -o remount,bind,ro "${MERGED}${target}"
	done < <(findmnt -rn -o TARGET | sort -u | awk '{print length, $0}' | sort -n | cut -d' ' -f2-)

	mount -t tmpfs -o "mode=1777,nosuid,nodev,size=${SUPERSET_TMP_SIZE:-4g}" tmpfs "${MERGED}/tmp"
	if [ "${SUPERSET_OVERLAY_SHARE:-run}" = run-only ]; then
		# Only this boot's state is shared with outside, from a tmpfs, so no line names the root disk.
		mount -t tmpfs -o mode=0755,nosuid,nodev,size=64m tmpfs "${MERGED}/run"
		mkdir -p "${MERGED}/run/superset"
		mount --bind /run/superset "${MERGED}/run/superset"
	else
		mount --rbind /run "${MERGED}/run"
		# The control plane rewrites the identity from outside while the box serves.
		mount --bind /etc/superset "${MERGED}/etc/superset"
		mount -o remount,bind,ro "${MERGED}/etc/superset"
	fi
	if [ "${SUPERSET_OVERLAY_SHARE:-run}" != run-only ]; then
		mkdir -p "${MERGED}/var/log/superset"
		mount --bind /var/log/superset "${MERGED}/var/log/superset"
	fi

	mkdir "${MERGED}/tmp/.oldroot"
	cd "$MERGED"
	pivot_root . tmp/.oldroot
	cd /
	umount -l /tmp/.oldroot
	rmdir /tmp/.oldroot

	setsid sleep infinity < /dev/null > /dev/null 2>&1 9>&- &
	echo "$!" > "${HOLDER}.tmp"
	mv -T "${HOLDER}.tmp" "$HOLDER"
	exec "$@"
}

case "${1:-}" in
	enter)
		shift
		mountpoint -q "$DRIVE" || { echo "superset-overlay-root: no drive at ${DRIVE}" >&2; exit 1; }
		# A boot after host-service died joins the namespace its terminals still use;
		# a second overlay on the same upper would be refused (index=on) or corrupt it.
		if pid="$(holder)"; then exec nsenter --target "$pid" --mount --wdns=/ -- "$@"; fi
		install -d -m 0755 "${DRIVE}/overlay/upper" "${DRIVE}/overlay/work"
		scrub_upper "${DRIVE}/overlay/upper"
		exec unshare --mount --propagation unchanged -- "$0" __inner "$@"
		;;
	__inner) shift; inner "$@" ;;
	run)
		shift
		pid="$(holder)" || { echo "superset-overlay-root: no live namespace" >&2; exit 1; }
		exec nsenter --target "$pid" --mount --wdns=/ -- "$@"
		;;
	status) holder > /dev/null && echo live || echo none ;;
	*) echo "usage: superset-overlay-root enter|run|status" >&2; exit 64 ;;
esac
