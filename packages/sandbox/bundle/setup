#!/usr/bin/env bash
# The bundle's runner. Installed with the bundle at /opt/superset/bundle/<sha>/,
# run by the image build once and by superset-boot on every start. Every
# subcommand is idempotent and cheap when nothing changed: files and assets
# are compared by hash sidecar, steps by version marker.
#
#   setup apply-rootfs               copy every tools.tsv row whose <dest>.hash differs
#   setup sync-assets                fetch every assets.tsv row whose <dest>.hash differs,
#                                    except an archive its step already consumed
#   setup run-steps                  run every steps.tsv row whose marker differs, fail-open;
#                                    a failed step skips only the steps that depend on it;
#                                    a step re-fetches the archives it consumes, then discards them
#   setup run-step <name>            one step, no sentinel (build time, or by hand)
#   setup status                     one line per step: name, version, marker, last outcome
set -uo pipefail

BUNDLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTRACT="${BUNDLE_DIR}/rootfs/etc/superset/contract.sh"
# shellcheck source=/dev/null
. "$CONTRACT"

STEPS_DIR="${SUPERSET_STEPS_DIR}"
SENTINEL_VERSION="2"
MAX_CONSECUTIVE_FAILURES=3

now_ms() { date +%s%3N; }
log() { printf '%s setup %s\n' "$(now_ms)" "$*"; }
b64d() { printf '%s' "$1" | base64 --decode; }
read_trimmed() { [ -f "$1" ] && tr -d '\n\r' < "$1"; }

# --- files shipped inside the bundle -------------------------------------
apply_rootfs() {
	local installed=0 skipped=0
	while IFS=$'\t' read -r mode hash src_b64 dest_b64; do
		[ -n "$mode" ] || continue
		local src dest
		src="${BUNDLE_DIR}/$(b64d "$src_b64")"
		dest="$(b64d "$dest_b64")"
		if [ "$(read_trimmed "${dest}.hash")" = "$hash" ] && [ -f "$dest" ]; then
			skipped=$((skipped + 1))
			continue
		fi
		install -D -m "$mode" "$src" "$dest"
		printf '%s' "$hash" > "${dest}.hash"
		installed=$((installed + 1))
	done < "${BUNDLE_DIR}/tools.tsv"
	log "apply-rootfs installed=${installed} skipped=${skipped}"
}

# A staged archive the manifest no longer names is an earlier build's; it
# would otherwise sit beside the current one forever, and a step that
# globs the directory could pick it. A sidecar alone is a discarded archive.
prune_media() {
	local sidecar hash
	for sidecar in "${SUPERSET_MEDIA_DIR}"/*.hash; do
		[ -f "$sidecar" ] || continue
		hash="$(tr -d '\n\r' < "$sidecar")"
		if ! grep -qF "$hash" "${BUNDLE_DIR}/assets.tsv"; then
			rm -f "${sidecar%.hash}" "$sidecar"
			log "pruned ${sidecar%.hash}"
		fi
	done
}

# --- files fetched by hash from the bucket -------------------------------
# Rows on stdin. With keep_discarded=1, a discarded archive (sidecar
# matches, file gone) stays gone: its step already consumed it.
fetch_rows() {
	local keep_discarded="$1" tmp changed
	tmp="$(mktemp -d)"
	changed="${tmp}/changed"
	mkdir -p "$changed"
	export SUPERSET_ASSET_BASE_URL SUPERSET_ASSET_TMP="$tmp" SUPERSET_ASSET_CHANGED="$changed" SUPERSET_ASSET_KEEP_DISCARDED="$keep_discarded"
	if ! xargs -r -d '\n' -P 16 -n 1 bash -c '
set -euo pipefail
line="$1"; tab=$'"'"'\t'"'"'
mode="${line%%$tab*}"; rest="${line#*$tab}"
hash="${rest%%$tab*}"; rest="${rest#*$tab}"
suffix="${rest%%$tab*}"; rest="${rest#*$tab}"
dest_b64="${rest%%$tab*}"; discarded_by=""
[ "$dest_b64" = "$rest" ] || discarded_by="${rest#*$tab}"
dest="$(printf "%s" "$dest_b64" | base64 --decode)"
current=""
if [ -f "$dest" ]; then
  if [ -f "${dest}.hash" ]; then current="$(tr -d "\n\r" < "${dest}.hash")"
  else current="$(sha256sum "$dest" | cut -d" " -f1)"; printf "%s" "$current" > "${dest}.hash"; fi
elif [ -n "$discarded_by" ] && [ "$SUPERSET_ASSET_KEEP_DISCARDED" = 1 ] && [ -f "${dest}.hash" ]; then
  current="$(tr -d "\n\r" < "${dest}.hash")"
fi
[ "$current" = "$hash" ] && exit 0
url="${SUPERSET_ASSET_BASE_URL}/${hash}${suffix}"
out="$(mktemp "${SUPERSET_ASSET_TMP}/asset-XXXXXX")"
# A content-addressed URL never changes, so a 404 is a not-yet-published asset or an edge
# that cached one before the upload landed; the retry after the plain fetch goes around it.
curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "$out" "$url" \
  || curl -fsSL --retry 2 --retry-delay 2 --retry-all-errors -o "$out" "${url}?fresh=$(date +%s)"
got="$(sha256sum "$out" | cut -d" " -f1)"
if [ "$got" != "$hash" ]; then echo "asset ${dest}: expected ${hash}, got ${got}" >&2; exit 1; fi
install -D -m "$mode" "$out" "$dest"
rm -f "$out"
printf "%s" "$hash" > "${dest}.hash"
case "$dest" in
  /usr/share/icons/*|/usr/share/pixmaps/*) touch "${SUPERSET_ASSET_CHANGED}/icons" ;;
  /usr/share/fonts/*) touch "${SUPERSET_ASSET_CHANGED}/fonts" ;;
esac
echo "fetched ${dest}"
' _; then
		rm -rf "$tmp"
		return 1
	fi
	[ -e "${changed}/icons" ] && gtk-update-icon-cache -f -q /usr/share/icons/hicolor 2>/dev/null
	[ -e "${changed}/fonts" ] && fc-cache -f >/dev/null 2>&1
	rm -rf "$tmp"
}

sync_assets() {
	local started
	started="$(now_ms)"
	prune_media
	fetch_rows 1 < "${BUNDLE_DIR}/assets.tsv" || return 1
	log "sync-assets done in $(( $(now_ms) - started ))ms"
}

discarded_rows() { awk -F'\t' -v n="$1" '$5 == n' "${BUNDLE_DIR}/assets.tsv"; }

# The sidecars stay: they are how sync-assets knows the archive was consumed.
discard_archives() {
	local dest_b64 dest
	for dest_b64 in $(discarded_rows "$1" | cut -f4); do
		dest="$(b64d "$dest_b64")"
		[ -f "$dest" ] || continue
		rm -f "$dest"
		log "discarded ${dest}"
	done
}

# --- versioned steps -----------------------------------------------------
step_version() { awk -F'\t' -v n="$1" '$1 == n { print $2 }' "${BUNDLE_DIR}/steps.tsv"; }
step_upstream() { awk -F'\t' -v n="$1" '$1 == n { print $4 }' "${BUNDLE_DIR}/steps.tsv"; }

run_step() {
	local name="$1" version marker
	version="$(step_version "$name")"
	[ -n "$version" ] || { echo "unknown step ${name}" >&2; return 1; }
	marker="${STEPS_DIR}/${name}.version"
	if [ "$(read_trimmed "$marker")" = "$version" ]; then
		log "step ${name} at ${version:0:12}, skipping"
		discard_archives "$name"
		return 0
	fi
	local started
	started="$(now_ms)"
	log "step ${name} running (${version:0:12})"
	if discarded_rows "$name" | fetch_rows 0 && SUPERSET_BUNDLE_DIR="$BUNDLE_DIR" bash "${BUNDLE_DIR}/steps/${name}.sh"; then
		mkdir -p "$STEPS_DIR"
		printf '%s\n' "$version" > "$marker"
		discard_archives "$name"
		log "step ${name} done in $(( $(now_ms) - started ))ms"
		return 0
	fi
	log "step ${name} FAILED after $(( $(now_ms) - started ))ms"
	return 1
}

failure_file() { printf '%s/%s.failure' "$STEPS_DIR" "$1"; }

# Consecutive failures of a step at its current version. A record from
# another schema, about a version this bundle no longer carries, or about a
# step that has since succeeded (by hand) says nothing: start over.
failure_count() {
	local file key value schema="" version="" count=0
	file="$(failure_file "$1")"
	[ -f "$file" ] || { echo 0; return 0; }
	if [ "$(read_trimmed "${STEPS_DIR}/${1}.version")" = "$(step_version "$1")" ]; then
		rm -f "$file"; echo 0; return 0
	fi
	while IFS='=' read -r key value; do
		case "$key" in
			sentinelVersion) schema="$value" ;;
			consecutiveFailures) count="$value" ;;
			failedStepVersion) version="$value" ;;
		esac
	done < "$file"
	if [ "$schema" != "$SENTINEL_VERSION" ] || [ "$version" != "$(step_version "$1")" ]; then
		rm -f "$file"; echo 0; return 0
	fi
	echo "$count"
}

write_failure() {
	mkdir -p "$STEPS_DIR"
	{
		printf 'sentinelVersion=%s\n' "$SENTINEL_VERSION"
		printf 'consecutiveFailures=%s\n' "$2"
		printf 'failedStepName=%s\n' "$1"
		printf 'failedStepVersion=%s\n' "$(step_version "$1")"
		printf 'lastFailureAtEpoch=%s\n' "$(date +%s)"
	} > "$(failure_file "$1")"
}

# Fail-open: a broken step never breaks the box. Three consecutive failures
# disable the step until its version changes. A failed or disabled step skips
# only the steps that list it upstream (steps.tsv's fourth column); every
# other step still runs. Success clears the step's record. Always exits 0.
run_steps() {
	rm -f "${STEPS_DIR}/failure.env"
	local -a names=() failed=()
	local name dep blocker count
	while IFS=$'\t' read -r name _; do [ -n "$name" ] && names+=("$name"); done < "${BUNDLE_DIR}/steps.tsv"
	for name in "${names[@]}"; do
		blocker=""
		for dep in $(step_upstream "$name" | tr ',' ' '); do
			if [[ " ${failed[*]} " == *" ${dep} "* ]]; then blocker="$dep"; break; fi
		done
		count="$(failure_count "$name")"
		if [ -n "$blocker" ]; then
			log "step ${name} skipped: downstream of failed ${blocker}"
		elif [ "$count" -ge "$MAX_CONSECUTIVE_FAILURES" ]; then
			log "step ${name} skipped: disabled after ${count} failures"
			failed+=("$name")
		elif run_step "$name"; then
			rm -f "$(failure_file "$name")"
		else
			write_failure "$name" $((count + 1))
			failed+=("$name")
		fi
	done
	return 0
}

status() {
	printf '%-24s %-13s %-13s %s\n' STEP VERSION MARKER STATE
	while IFS=$'\t' read -r name version _; do
		[ -n "$name" ] || continue
		local marker state failures
		marker="$(read_trimmed "${STEPS_DIR}/${name}.version")"
		failures="$(failure_count "$name")"
		if [ "$marker" = "$version" ]; then state="current"
		elif [ "$failures" -gt 0 ]; then state="failed x${failures}"
		elif [ -z "$marker" ]; then state="never run"
		else state="pending"; fi
		printf '%-24s %-13s %-13s %s\n' "$name" "${version:0:12}" "${marker:0:12}" "$state"
	done < "${BUNDLE_DIR}/steps.tsv"
}

case "${1:-}" in
	apply-rootfs) apply_rootfs ;;
	sync-assets) sync_assets ;;
	run-steps) run_steps ;;
	run-step) run_step "${2:?step name}" ;;
	status) status ;;
	*) echo "usage: setup apply-rootfs | sync-assets | run-steps | run-step <name> | status" >&2; exit 64 ;;
esac
