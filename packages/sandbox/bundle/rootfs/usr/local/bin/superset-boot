#!/usr/bin/env bash
# The per-boot runner, run as root by the control plane through the sandbox
# API on every create and every wake, with HOST_SERVICE_SECRET in its env.
# A wake restores the disk and no processes, so everything here is about
# turning a filesystem into a running box, cheaply when nothing changed:
#
#   clear /run/superset            facts about a boot that is over
#   read the contract and identity /etc/superset/{contract.sh,sandbox.conf}
#   lay out the workspace drive    only when the control plane mounted one;
#                                  refuse when sandbox.conf names a drive that is not mounted
#   install the pinned bundle      only when its hash differs from current
#   apply-rootfs, and the steps    each a hash compare per file and step;
#   marked beforeHost              the only steps host-service waits for
#   link the drive's agents        only when the control plane mounted one
#   start host-service as ubuntu   first; everything else is a side effect
#   then, detached: sync-assets and the other steps, then the desktop;
#   the checkout beside them; checkout.ready and the start hook after both
#
# Every phase is stamped to the boot log in milliseconds; host-service serves
# the log on its health route so a boot is measurable from outside.
set -uo pipefail
. /etc/superset/contract.sh

# The control plane runs this from the image's workdir, which the checkout
# below may replace; every child would inherit a deleted cwd.
cd /

# One line per phase: `<epoch ms> <phase> [detail]`. host-service reports the
# current boot's phases on health.check, so a phase is one dotted token.
stamp() { printf '%s %s\n' "$(date +%s%3N)" "$*" >> "$SUPERSET_BOOT_LOG"; }
refuse() { stamp "boot.refused $*"; echo "superset-boot: $*" >&2; exit 1; }
as_user() { runuser -u "$SUPERSET_USER" -- "$@"; }

mkdir -p "$SUPERSET_LOG_DIR" "$SUPERSET_STATE_DIR"

# --- identity: the file the control plane writes before every boot.
[ -f "$SUPERSET_CONF" ] || refuse "no ${SUPERSET_CONF}; the control plane writes it before boot"
set -a
# shellcheck source=/dev/null
. "$SUPERSET_CONF"
set +a
[ "${SUPERSET_SANDBOX_CONTRACT:-}" = "$SUPERSET_CONTRACT_VERSION" ] ||
	refuse "sandbox.conf is contract ${SUPERSET_SANDBOX_CONTRACT:-none}; this bundle speaks ${SUPERSET_CONTRACT_VERSION}"
[ -n "${HOST_SERVICE_SECRET:-}" ] || refuse "HOST_SERVICE_SECRET missing from the boot env"

# A wake that races a wake, or a re-delivered provision, must not stack a
# second host-service on a live one, nor on one still being booted: the pid
# file below is written only after the passes. The lock is held until it is.
# A reexec inherits fd 9 with the lock still on it.
[ -e "/proc/$$/fd/9" ] || exec 9> /run/superset-boot.lock
flock -n -E 75 9 || { [ $? -eq 75 ] && exit 0; refuse "cannot take the boot lock"; }
if [ -f "${SUPERSET_RUN_DIR}/host-service.pid" ] && kill -0 "$(cat "${SUPERSET_RUN_DIR}/host-service.pid")" 2>/dev/null; then
	exit 0
fi

stamp "boot.start pid=$$ bundle=$(cat "${SUPERSET_BUNDLE_ROOT}/current.bundle-hash" 2>/dev/null | cut -c1-12)"

# --- per-boot state: a restored disk carries the previous session's pids
# and ready flags, which describe processes that no longer exist.
rm -rf "$SUPERSET_RUN_DIR"
install -d -m 0755 -o "$SUPERSET_USER" -g "$SUPERSET_USER" "$SUPERSET_RUN_DIR"
stamp "run.cleared"

# --- the workspace drive, when the environment is in drive mode: /workspace
# and the large home state live on it, so they never enter the box's
# snapshot. Bind mounts end with the session, so every boot does this, before
# anything reads /workspace. A bind mount, not a symlink: paths must not move.
DRIVE_MODE=""
user_path() {
	local dir="$1" part IFS=/
	for part in $2; do
		dir="${dir}/${part}"
		[ -d "$dir" ] || install -d -o "$SUPERSET_USER" -g "$SUPERSET_USER" "$dir"
	done
}
bind_into() {
	mountpoint -q "$2" || mount --bind "$1" "$2" || refuse "cannot bind ${1} onto ${2}"
}
# In drive mode, what describes the drive's contents lives on the drive.
use_drive_state() {
	SUPERSET_HOST_DB="${SUPERSET_DRIVE_STATE_DIR}/host.db"
	SUPERSET_CHECKOUTS_DIR="${SUPERSET_DRIVE_STATE_DIR}/checkouts"
}
# A subtree the drive lacks is seeded from what the image left there, under a
# temporary name, so a boot that dies halfway never leaves a partial copy.
seed_home_subtree() {
	local sub="$1" target="${drive}/home/$1" tmp="${drive}/home/$1.seeding"
	[ "$sub" = "${sub%/*}" ] || user_path "${drive}/home" "${sub%/*}"
	rm -rf "$tmp"
	install -d -o "$SUPERSET_USER" -g "$SUPERSET_USER" "$tmp"
	if [ -d "${SUPERSET_USER_HOME}/${sub}" ]; then
		cp -a "${SUPERSET_USER_HOME}/${sub}/." "${tmp}/" || refuse "cannot seed ${target}"
	fi
	mv -T "$tmp" "$target" || refuse "cannot seed ${target}"
}
layout_drive() {
	local drive="${SUPERSET_DRIVE_DIR:-}" started sub owner sentinel
	if [ -z "$drive" ] || ! mountpoint -q "$drive"; then
		# Without its drive the box would serve the root disk's empty /workspace as the user's work.
		[ -z "${SUPERSET_SANDBOX_DRIVE:-}" ] && return 0
		stamp "drive.missing ${SUPERSET_SANDBOX_DRIVE} is not mounted at ${drive:-the drive path}"
		refuse "the workspace drive ${SUPERSET_SANDBOX_DRIVE} is not mounted"
	fi
	: "${SUPERSET_DRIVE_STATE_DIR:=${drive}/state}"
	sentinel="${SUPERSET_DRIVE_STATE_DIR}/workspace-id"
	owner="$(cat "$sentinel" 2>/dev/null || true)"
	if [ -n "$owner" ] && [ "$owner" != "$SUPERSET_SANDBOX_WORKSPACE_ID" ]; then
		stamp "drive.foreign ${SUPERSET_SANDBOX_DRIVE:-} belongs to workspace ${owner}"
		refuse "the drive at ${drive} belongs to workspace ${owner}"
	fi
	if [ -z "$owner" ] && [ -n "${SUPERSET_SANDBOX_DRIVE_LAID_OUT:-}" ]; then
		stamp "drive.unlaid ${SUPERSET_SANDBOX_DRIVE:-} carries no workspace id though it was laid out before"
		refuse "the drive at ${drive} is not this workspace's laid-out drive"
	fi
	started="$(date +%s%3N)"
	user_path "$drive" workspace
	user_path "$drive" home
	user_path "$drive" state
	install -d -m 0700 "${drive}/swap"
	install -d -m 0710 "${drive}/docker"
	install -d -o "$SUPERSET_USER" -g "$SUPERSET_USER" "$SUPERSET_WORKSPACE_DIR"
	bind_into "${drive}/workspace" "$SUPERSET_WORKSPACE_DIR"
	for sub in ${SUPERSET_DRIVE_HOME_SUBTREES:-}; do
		[ -d "${drive}/home/${sub}" ] || seed_home_subtree "$sub"
		user_path "$SUPERSET_USER_HOME" "$sub"
		bind_into "${drive}/home/${sub}" "${SUPERSET_USER_HOME}/${sub}"
	done
	if [ -z "$owner" ]; then
		printf '%s\n' "$SUPERSET_SANDBOX_WORKSPACE_ID" > "${sentinel}.tmp" && mv -T "${sentinel}.tmp" "$sentinel" ||
			refuse "cannot write ${sentinel}"
	fi
	DRIVE_MODE=1
	use_drive_state
	printf 'export BUN_INSTALL_CACHE_DIR=%s npm_config_store_dir=%s\n' "$SUPERSET_BUN_STORE" "$SUPERSET_PNPM_STORE" > "${SUPERSET_RUN_DIR}/drive.env"
	stamp "drive.layout ms=$(( $(date +%s%3N) - started ))"
}
layout_drive

# --- the bundle the environment pins. A box with no pin would silently keep
# whatever its image or golden baked, for as long as it lives.
[ -n "${SUPERSET_BUNDLE_SHA:-}" ] || refuse "SUPERSET_BUNDLE_SHA missing from ${SUPERSET_CONF}; the control plane pins every box"
ensure_bundle() {
	local want="$SUPERSET_BUNDLE_SHA" have
	have="$(cat "${SUPERSET_BUNDLE_ROOT}/current.bundle-hash" 2>/dev/null || true)"
	if [ "$have" = "$want" ] && [ -x "${SUPERSET_BUNDLE_ROOT}/current/setup" ]; then
		stamp "bundle.current ${want:0:12} matches pin"
		return 0
	fi
	local dir="${SUPERSET_BUNDLE_ROOT}/${want}"
	if [ ! -x "${dir}/setup" ]; then
		local tmp
		tmp="$(mktemp)"
		stamp "bundle.fetching ${want:0:12}"
		if ! curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o "$tmp" "${SUPERSET_ASSET_BASE_URL}/${want}.tar.gz"; then
			rm -f "$tmp"; stamp "bundle.fetch.failed keeping ${have:0:12}"; return 1
		fi
		local got
		got="$(sha256sum "$tmp" | cut -d' ' -f1)"
		if [ "$got" != "$want" ]; then rm -f "$tmp"; stamp "bundle.hash.mismatch got=${got:0:12} keeping ${have:0:12}"; return 1; fi
		rm -rf "$dir"; mkdir -p "$dir"
		tar -xzf "$tmp" -C "$dir"; rm -f "$tmp"
		chmod 755 "${dir}/setup"
	fi
	ln -sfn "$dir" "${SUPERSET_BUNDLE_ROOT}/current.tmp"
	mv -T "${SUPERSET_BUNDLE_ROOT}/current.tmp" "${SUPERSET_BUNDLE_ROOT}/current"
	printf '%s\n' "$want" > "${SUPERSET_BUNDLE_ROOT}/current.bundle-hash"
	for old in "${SUPERSET_BUNDLE_ROOT}"/*/; do
		old="${old%/}"
		[ -L "$old" ] && continue
		[ "$old" = "$dir" ] && continue
		[ "$(basename "$old")" = "$have" ] && continue
		rm -rf "$old"
	done
	stamp "bundle.installed ${want:0:12} was ${have:0:12}"
}
self_hash() { sha256sum "$0" 2>/dev/null | cut -d' ' -f1; }
BOOT_HASH_BEFORE="$(self_hash)"

ensure_bundle || true
BUNDLE="${SUPERSET_BUNDLE_ROOT}/current"

# --- the passes host-service needs. Steps are fail-open; a broken desktop
# step degrades the desktop, never the workspace.
stamp "rootfs.start"; "$BUNDLE/setup" apply-rootfs >> "$SUPERSET_BOOT_LOG" 2>&1; stamp "rootfs.end"
# apply-rootfs may have replaced the contract; re-read it.
. /etc/superset/contract.sh
[ -z "$DRIVE_MODE" ] || use_drive_state
# It may also have replaced this script. The shell is running the copy the
# image baked, so without this a bundle's change to the boot script only
# takes effect on the boot after the one that installed it — which is how an
# older image's checkout raced a newer bundle's. Once per boot: the guard
# stops a bundle whose script never settles from spinning here.
if [ -z "${SUPERSET_BOOT_REEXEC:-}" ] && [ "$(self_hash)" != "$BOOT_HASH_BEFORE" ]; then
	stamp "boot.reexec into the installed bundle's script"
	SUPERSET_BOOT_REEXEC=1 exec "$0" "$@"
fi
stamp "steps.host.start"; "$BUNDLE/setup" run-steps before-host >> "$SUPERSET_BOOT_LOG" 2>&1; stamp "steps.host.end"

# A reexec lays the drive out with the installed bundle's contract.
[ -n "$DRIVE_MODE" ] || layout_drive

# In drive mode, Docker's images and layers go on the drive too. apply-rootfs
# compares only the hash sidecar, so this rewrite stays until the bundle
# ships a new daemon.json, and then it is merged again right here.
configure_docker() {
	[ -n "$DRIVE_MODE" ] || return 0
	local want
	want="$(jq -c --arg root "${SUPERSET_DRIVE_DIR}/docker" '. + {"data-root": $root}' "${BUNDLE}/rootfs/etc/docker/daemon.json")" ||
		{ stamp "docker.config.failed"; return 0; }
	[ "$(jq -c . /etc/docker/daemon.json 2>/dev/null)" = "$want" ] || printf '%s\n' "$want" > /etc/docker/daemon.json
	stamp "docker.data-root ${SUPERSET_DRIVE_DIR}/docker"
}
configure_docker

# --- the agent CLIs from the region's agent-tools drive, when the control
# plane mounted one. Without it the image's agents stay on PATH. Mounts are
# per session, so a link into a mount this session lacks points nowhere.
link_agents() {
	local dir="${SUPERSET_AGENTS_DIR:-/opt/agents}" linked=0 name sha bin target
	local manifest="${dir}/manifest.json"
	if find /usr/local/bin -maxdepth 1 -lname "${dir}/*" ! -exec test -e {} \; -print -quit | grep -q .; then
		SUPERSET_BUNDLE_DIR="$BUNDLE" bash "$BUNDLE/steps/install-agent-clis.sh" >> "$SUPERSET_BOOT_LOG" 2>&1 ||
			stamp "agents.restore.failed"
		# What is still dangling has no image copy to restore: opencode, pi.
		find /usr/local/bin -maxdepth 1 -lname "${dir}/*" ! -exec test -e {} \; -delete
	fi
	if ! jq -e 'type == "array"' "$manifest" > /dev/null 2>&1; then
		stamp "agents.unavailable no manifest at ${dir}"
		return 0
	fi
	while IFS=$'\t' read -r name sha bin; do
		if ! [[ "$name" =~ ^[a-z0-9-]+$ && "$sha" =~ ^[0-9a-f]{64}$ && "$bin" =~ ^[A-Za-z0-9._/-]+$ && "$bin" != *..* ]]; then
			stamp "agents.skipped invalid entry ${name:0:32}"; continue
		fi
		target="${dir}/${name}/${sha}/${bin}"
		[ -x "$target" ] || { stamp "agents.missing ${name} ${sha:0:12}"; continue; }
		ln -sfn "$target" "/usr/local/bin/${name}.tmp" && mv -T "/usr/local/bin/${name}.tmp" "/usr/local/bin/${name}" &&
			linked=$((linked + 1))
	done < <(jq -r '.[] | [.name, .sha, .bin] | map(tostring) | @tsv' "$manifest")
	stamp "agents.linked ${linked} from ${dir}"
}
drive_links() { find /usr/local/bin -maxdepth 1 -lname "${SUPERSET_AGENTS_DIR:-/opt/agents}/*" -printf '%f %l\n' | sort; }
link_agents

# --- host-service, as the sandbox user, first. A runtime that cannot start
# is logged, not fatal: the desktop and the checkout still come up so the
# box can be looked at, and the control plane marks the workspace failed.
HOST="${SUPERSET_HOST_ROOT}/current"
# install-host keeps the previous runtime; once the current one answers, it is garbage.
prune_runtimes() {
	local keep dir
	keep="$(readlink -f "$HOST")" || return 0
	for dir in "${SUPERSET_HOST_ROOT}"/*/; do
		dir="${dir%/}"
		[ -L "$dir" ] || [ "$dir" = "$keep" ] && continue
		rm -rf "$dir" && stamp "host.pruned ${dir##*/}"
	done
}
start_host_service() {
[ -f "${HOST}/host-service.js" ] || { stamp "host.missing no runtime at ${HOST}"; return 0; }
chown -R "$SUPERSET_USER:$SUPERSET_USER" "$SUPERSET_STATE_DIR" "$SUPERSET_LOG_DIR"
if [ ! -f "$SUPERSET_HOST_DB" ] && [ -f "${HOST}/host.db.template" ]; then
	install -m 0644 -o "$SUPERSET_USER" -g "$SUPERSET_USER" "${HOST}/host.db.template" "$SUPERSET_HOST_DB"
	stamp "hostdb.seeded from template"
fi
# The workspace files belong to the user; a golden built as root left them root's.
[ -d "$SUPERSET_WORKSPACE_DIR" ] && [ "$(stat -c %U "$SUPERSET_WORKSPACE_DIR")" != "$SUPERSET_USER" ] &&
	chown -R "$SUPERSET_USER:$SUPERSET_USER" "$SUPERSET_WORKSPACE_DIR" && stamp "workspace.chowned to ${SUPERSET_USER}"

# The firewall terminates TLS for the hosts it injects credentials into and
# mounts its CA in the system bundle. curl, git and bun read that bundle; node
# does not, so without this every node fetch to GitHub fails the certificate
# check — including host-service's own pull-request lookups.
: "${NODE_EXTRA_CA_CERTS:=/etc/ssl/certs/ca-certificates.crt}"
export NODE_EXTRA_CA_CERTS

host_env=(
	"HOME=${SUPERSET_USER_HOME}" "USER=${SUPERSET_USER}" "LOGNAME=${SUPERSET_USER}"
	"PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin"
	"NODE_ENV=production" "PORT=${SUPERSET_HOST_SERVICE_PORT}"
	"ORGANIZATION_ID=${SUPERSET_SANDBOX_ORGANIZATION_ID}"
	"HOST_DB_PATH=${SUPERSET_HOST_DB}" "HOST_MIGRATIONS_FOLDER=${HOST}/drizzle"
	"AUTH_TOKEN=sandbox" "SUPERSET_API_URL=${SUPERSET_API_URL}" "SUPERSET_HOST_RUN_MODE=sandbox"
	"SUPERSET_SANDBOX_WORKSPACE_ID=${SUPERSET_SANDBOX_WORKSPACE_ID}"
	"SUPERSET_SANDBOX_ORGANIZATION_ID=${SUPERSET_SANDBOX_ORGANIZATION_ID}"
	"SUPERSET_SANDBOX_WORKSPACE_PATH=${SUPERSET_WORKSPACE_DIR}"
	"SUPERSET_SANDBOX_REPOSITORIES=${SUPERSET_SANDBOX_REPOSITORIES}"
	"SUPERSET_SANDBOX_IMAGE_TAG=${SUPERSET_SANDBOX_IMAGE_TAG}" "SUPERSET_SANDBOX_PROVIDER=${SUPERSET_SANDBOX_PROVIDER}"
	"SUPERSET_RUN_DIR=${SUPERSET_RUN_DIR}" "SUPERSET_SANDBOX_BOOT_LOG=${SUPERSET_BOOT_LOG}"
	"HOST_SERVICE_SECRET=${HOST_SERVICE_SECRET}"
)
[ -n "$DRIVE_MODE" ] && host_env+=("BUN_INSTALL_CACHE_DIR=${SUPERSET_BUN_STORE}" "npm_config_store_dir=${SUPERSET_PNPM_STORE}")
for key in HOST_SERVICE_SENTRY_DSN HOST_SERVICE_SENTRY_ENVIRONMENT SUPERSET_SANDBOX_CREATOR_USER_ID \
	SUPERSET_SANDBOX_PLUGINS \
	SUPERSET_SANDBOX_AGENT SUPERSET_SANDBOX_AGENT_PROMPT SUPERSET_SANDBOX_AGENT_MODEL SUPERSET_SANDBOX_AGENT_EFFORT SUPERSET_SANDBOX_AGENT_MODE SUPERSET_SANDBOX_AGENT_ATTACHMENTS SUPERSET_SANDBOX_AGENT_SURFACE SUPERSET_SANDBOX_AGENT_AUTOMATION_RUN_ID SUPERSET_SANDBOX_AGENT_TERMINAL_ID \
	NODE_EXTRA_CA_CERTS NODE_USE_SYSTEM_CA SSL_CERT_FILE CURL_CA_BUNDLE REQUESTS_CA_BUNDLE AWS_CA_BUNDLE GIT_SSL_CAINFO NPM_CONFIG_CAFILE PIP_CERT CARGO_HTTP_CAINFO; do
	[ -n "${!key:-}" ] && host_env+=("${key}=${!key}")
done
host_node="${HOST}/node"
[ -x "$host_node" ] || host_node=node
stamp "host.exec $(cat "${SUPERSET_HOST_ROOT}/current.version" 2>/dev/null) node=${host_node}"
# setpriv execs in place, so the pid recorded is node's own and the process
# that answers kill -0 is the one that serves.
(cd "$SUPERSET_USER_HOME" && exec setpriv --reuid="$SUPERSET_USER" --regid="$SUPERSET_USER" --init-groups \
	env -i "${host_env[@]}" "$host_node" "${HOST}/host-service.js") >> "${SUPERSET_LOG_DIR}/host-service.log" 2>&1 9>&- &
echo $! > "${SUPERSET_RUN_DIR}/host-service.pid"
(
	for _ in $(seq 1 600); do
		if curl -fs -o /dev/null "http://127.0.0.1:${SUPERSET_HOST_SERVICE_PORT}/trpc/health.check"; then
			touch "${SUPERSET_RUN_DIR}/host-service.ready"; stamp "host.ready"; prune_runtimes; exit 0
		fi
		sleep 0.1
	done
	stamp "host.timeout after 60s"
) 9>&- &
}
start_host_service
exec 9>&-

# What the box has, for anything that sizes itself: the cgroup's ceiling,
# not the VM's, is what the kernel enforces. Login shells source this.
mem_bytes="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || true)"
case "$mem_bytes" in ''|max) mem_bytes=$(( $(awk '/MemTotal/ {print $2}' /proc/meminfo) * 1024 )) ;; esac
printf 'export SUPERSET_SANDBOX_MEMORY_MB=%s SUPERSET_SANDBOX_VCPUS=%s\n' "$(( mem_bytes / 1048576 ))" "$(nproc)" > "${SUPERSET_RUN_DIR}/resources.env"
stamp "resources.written memory_mb=$(( mem_bytes / 1048576 )) vcpus=$(nproc)"

# Ranks every process for the OOM killer and reaps the largest one before the
# kernel has to; see the script. Root, because lowering a score needs it.
if [ -x /usr/local/bin/superset-memguard ]; then
	/usr/local/bin/superset-memguard >> "${SUPERSET_LOG_DIR}/memguard.log" 2>&1 9>&- &
	echo $! > "${SUPERSET_RUN_DIR}/memguard.pid"
	stamp "memguard.start pid=$!"
fi

# The fixed swapfile of an earlier bundle; memguard adds swap on demand now.
[ -f /swapfile ] && ! grep -q "^/swapfile " /proc/swaps && rm -f /swapfile

# The repository's start hook: the services a workspace needs every boot.
# host-service runs it, because the environment the hook needs is pushed
# into host-service after boot and never leaves it; this runner decides
# when: once host-service answers, the push has landed and the checkout is in.
start_hook() {
	local api="http://127.0.0.1:${SUPERSET_HOST_SERVICE_PORT}/trpc/sandbox"
	local auth="Authorization: Bearer ${HOST_SERVICE_SECRET}"
	local i
	for i in $(seq 1 1200); do
		[ -f "${SUPERSET_RUN_DIR}/host-service.ready" ] &&
			curl -fs -H "$auth" "${api}.status" 2>/dev/null | grep -q '"environmentPushed":true' && break
		sleep 0.1
	done
	if [ "$i" -ge 1200 ]; then stamp "hook.skipped no environment push within 120s"; return 0; fi
	local out
	out="$(curl -fs -X POST -H "$auth" -H 'Content-Type: application/json' -d '{}' "${api}.runStartHook" 2>&1)" ||
		{ stamp "hook.failed ${out:0:160}"; return 0; }
	case "$out" in
		*'"started":true'*) stamp "hook.started ${out}" ;;
		*'"no-hook"'*) stamp "hook.none" ;;
		*) stamp "hook.skipped ${out:0:160}" ;;
	esac
}

# One checkout per repository in SUPERSET_SANDBOX_REPOSITORIES, each at
# <workspace>/<path> on its branch, or at the workspace root itself when its
# path is ".". A marker per path under the state directory says it is done;
# a golden has the markers stripped so a fork fetches its branch into the
# checkout it inherited.
checkout_one() {
	local url="$1" branch="$2" path="$3" base="$4"
	[ -n "$base" ] || base="$branch"
	local ws="${SUPERSET_WORKSPACE_DIR}/${path}" marker="${SUPERSET_CHECKOUTS_DIR}/${path}"
	if [ "$path" = "." ]; then ws="$SUPERSET_WORKSPACE_DIR"; marker="${SUPERSET_CHECKOUTS_DIR}/@root"; fi
	if [ -f "$marker" ]; then stamp "checkout.skipped ${path} already done"; return 0; fi
	local baked
	baked="$(as_user git -C "$ws" remote get-url origin 2>/dev/null || true)"
	if [ "$baked" = "$url" ] && [ -d "$ws/.git" ]; then
		# On a drive, a checkout that already has the branch is the user's work.
		if [ -n "$DRIVE_MODE" ] && as_user git -C "$ws" rev-parse -q --verify "refs/heads/${branch}" > /dev/null; then
			touch "$marker"; stamp "checkout.kept ${path} ${branch} is already on the drive"; return 0
		fi
		if as_user git -C "$ws" fetch -q --depth 1 origin "$base" && as_user git -C "$ws" checkout -q -B "$branch" FETCH_HEAD; then
			touch "$marker"; stamp "checkout.fetched ${path} ${branch} from ${base}"; return 0
		fi
		if [ -n "$DRIVE_MODE" ]; then
			stamp "checkout.kept ${path} fetch failed; the checkout on the drive is left as it is"; return 1
		fi
		# A clone a previous session interrupted leaves a repository that can
		# fetch nothing; start over rather than fail every boot.
		stamp "checkout.fetch.failed ${path} ${branch}; recloning"
	fi
	if [ -n "$DRIVE_MODE" ] && [ -n "$(find "$ws" -mindepth 1 -maxdepth 1 ! -name '.clone.*' ! -name '.superset' -print -quit 2>/dev/null)" ]; then
		stamp "checkout.kept ${path} ${ws} is not empty; nothing on the drive is replaced"; return 1
	fi
	# Clone beside the target and move the result in, the worktree first and
	# .git last, so the directory becomes a repository in one rename: host-service
	# seeds the workspace row before the checkout lands and would otherwise find
	# a half-written .git and fetch into it. The directory itself is emptied
	# rather than replaced, so a shell already sitting in it keeps a live cwd.
	local tmp
	tmp="$(mktemp -d "${SUPERSET_WORKSPACE_DIR}/.clone.XXXXXX")"
	chown "$SUPERSET_USER:$SUPERSET_USER" "$tmp"
	if as_user git clone -q --depth 1 --single-branch --branch "$base" "$url" "$tmp" \
		|| { find "$tmp" -mindepth 1 -delete; as_user git clone -q --depth 1 "$url" "$tmp"; }; then
		as_user git -C "$tmp" checkout -q -B "$branch"
		install -d -o "$SUPERSET_USER" -g "$SUPERSET_USER" "$ws"
		if [ -n "$DRIVE_MODE" ]; then
			# Only the package stores can be here; a repository's own .superset/ merges into theirs.
			( shopt -s dotglob nullglob; for entry in "$tmp"/*; do
				[ "${entry##*/}" = ".git" ] && continue
				if [ -d "${ws}/${entry##*/}" ]; then cp -a "$entry/." "${ws}/${entry##*/}/" && rm -rf "$entry"; else mv "$entry" "$ws"/; fi
			done )
		else
			find "$ws" -mindepth 1 -maxdepth 1 ! -name '.clone.*' -exec rm -rf {} +
			( shopt -s dotglob nullglob; for entry in "$tmp"/*; do [ "${entry##*/}" = ".git" ] || mv "$entry" "$ws"/; done )
		fi
		mv "$tmp/.git" "$ws/.git"; rmdir "$tmp"
		touch "$marker"; stamp "checkout.cloned ${path} ${url}"; return 0
	fi
	rm -rf "$tmp"; stamp "checkout.clone.failed ${path}"; return 1
}
checkout() {
	exec >> "${SUPERSET_LOG_DIR}/checkout.log" 2>&1
	install -d -o "$SUPERSET_USER" -g "$SUPERSET_USER" "$SUPERSET_WORKSPACE_DIR"
	install -d "$SUPERSET_CHECKOUTS_DIR"
	local failed=0 url branch path base
	while IFS=$'\t' read -r url branch path base; do
		[ -n "$path" ] || continue
		checkout_one "$url" "$branch" "$path" "$base" || failed=1
	done < <(printf '%s' "$SUPERSET_SANDBOX_REPOSITORIES" | jq -r '.[] | [.url, .branch, .path, (.baseBranch // "")] | @tsv')
	exclude_stores
	return "$failed"
}
# The package stores sit inside a root checkout in drive mode; git must not
# see them. Only stores/: a repository may track a .superset/ of its own.
exclude_stores() {
	local exclude="${SUPERSET_WORKSPACE_DIR}/.git/info/exclude"
	[ -n "$DRIVE_MODE" ] && [ -d "${SUPERSET_WORKSPACE_DIR}/.git" ] || return 0
	grep -qxF '/.superset/stores/' "$exclude" 2>/dev/null && return 0
	as_user mkdir -p "${exclude%/*}"
	printf '/.superset/stores/\n' | as_user tee -a "$exclude" > /dev/null
}

# --- the rest of the passes, then the desktop, beside the checkout.
# checkout.ready waits for the steps too: the first agent launch, the start
# hook and the golden build wait for it. The lock makes a boot after
# host-service died in this session wait for this boot's steps.
(
	(
		stamp "checkout.start"
		checkout; status=$?
		stamp "checkout.end"
		exit "$status"
	) &
	checkout_pid=$!
	exec 8> /run/superset-steps.lock
	flock 8
	links_before="$(drive_links)"
	stamp "assets.start"; "$BUNDLE/setup" sync-assets >> "$SUPERSET_BOOT_LOG" 2>&1 || stamp "assets.failed continuing"; stamp "assets.end"
	stamp "steps.start"; "$BUNDLE/setup" run-steps after-host >> "$SUPERSET_BOOT_LOG" 2>&1; stamp "steps.end"
	[ "$(drive_links)" = "$links_before" ] || link_agents
	exec 8>&-
	as_user env "DISPLAY=${SUPERSET_DISPLAY}" "HOME=${SUPERSET_USER_HOME}" "USER=${SUPERSET_USER}" \
		"SUPERSET_SANDBOX_WORKSPACE_ID=${SUPERSET_SANDBOX_WORKSPACE_ID}" \
		/usr/local/bin/superset-desktop-init >> "${SUPERSET_LOG_DIR}/desktop.log" 2>&1 &
	stamp "desktop.start"
	wait "$checkout_pid" && touch "${SUPERSET_RUN_DIR}/checkout.ready" && start_hook
) &

stamp "boot.done"
