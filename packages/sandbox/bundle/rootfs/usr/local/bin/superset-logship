#!/usr/bin/env bash
# Sends the platform's own box logs to Sentry Logs. Started by superset-boot as
# root beside memguard, only when sandbox.conf has SUPERSET_SANDBOX_BOX_LOGS=1;
# it does not need host-service. Each pass, every few seconds:
#
#   read    boot, memguard, desktop and host-service logs from the byte offset
#           saved for each under the state directory. start-hook.log and
#           checkout.log are the customer's output and are never read. Offsets
#           are trusted only if this script also ran in the previous boot; else
#           each file starts at its first line of the current boot.
#   filter  drop host-service vitals and memguard rank lines; replace the start
#           hook's command with a marker; scrub token formats; collapse a run
#           of identical lines into one record with a count.
#   cap     a budget of serialized record bytes per box per clock hour; one record
#           says it was reached, and the lines after it are dropped, not held.
#   send    one envelope per file per pass. The offset moves only on a 2xx, so a
#           box that sleeps first sends those lines at its next wake. A refusal
#           waits (Retry-After, else doubling up to an hour) and keeps nothing in
#           memory: the log files are the only queue.
#
# --once runs one pass and exits. It prints one line per refusal, never per line of log.
set -uo pipefail
. "${SUPERSET_CONTRACT:-/etc/superset/contract.sh}"

[ "${SUPERSET_SANDBOX_BOX_LOGS:-}" = 1 ] || exit 0
DSN="${HOST_SERVICE_SENTRY_DSN:-}"
if ! [[ "$DSN" =~ ^(https?)://([^@/:]+)(:[^@/]*)?@([^/]+)(/.*)?/([0-9]+)/?$ ]]; then
	echo "logship: no usable DSN; not sending"; exit 0
fi
ENVELOPE_URL="${BASH_REMATCH[1]}://${BASH_REMATCH[4]}${BASH_REMATCH[5]}/api/${BASH_REMATCH[6]}/envelope/"
AUTH="X-Sentry-Auth: Sentry sentry_version=7, sentry_key=${BASH_REMATCH[2]}, sentry_client=superset-logship/1"

SOURCES=(boot memguard desktop host-service)
STATE="${SUPERSET_STATE_DIR}/logship"
CAP="${SUPERSET_SANDBOX_BOX_LOGS_CAP_BYTES:-262144}"
INTERVAL_S="${SUPERSET_LOGSHIP_INTERVAL_S:-5}"
MAX_READ=65536
MAX_RECORDS=100
MAX_BODY=8192
MAX_WAIT_S=3600

mkdir -p "$STATE"
exec 7> "${STATE}/lock"
flock -n 7 || exit 0

now_ms() { echo "${SUPERSET_LOGSHIP_NOW_MS:-$(date +%s%3N)}"; }
TRACE_ID="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"

read_state() { local v; v="$(cat "${STATE}/$1" 2>/dev/null)" && echo "$v" || echo "$2"; }
write_state() { printf '%s\n' "$2" > "${STATE}/$1.tmp" && mv -f "${STATE}/$1.tmp" "${STATE}/$1"; }

# `R <offset> <count> <line>` for each record and `D <line start>` for each dropped
# line, whose time a following line without one inherits; then `E <offset>` for
# how far the file is read. A trailing line with no newline yet waits a pass.
read -r -d '' SPLIT <<'AWK'
function handle(line, len,   key, plen, i) {
	if (stop) return
	key = line
	sub(/^[0-9]+ /, "", key)
	sub(/^[0-9][0-9-]*T[0-9:.]*Z /, "", key)
	if ((src == "host-service" && index(key, "[host-service:vitals]") == 1) ||
		(src == "memguard" && index(key, "memguard rank ") == 1)) {
		if (!have) { printf "D\t%s\n", substr(line, 1, 30); pos += len; return }
		dropped = dropped substr(line, 1, 30) "\n"; pos += len; return
	}
	if (src == "host-service" && (index(key, "[sandbox] start hook ") == 1 || index(key, "[sandbox] archive hook ") == 1) && (i = index(key, ": ")) > 0) {
		plen = length(line) - length(key)
		key = substr(key, 1, i + 1) "[command not sent]"
		line = substr(line, 1, plen) key
	}
	if (have && key == prevkey) { count++; dropped = dropped substr(line, 1, 30) "\n"; pos += len; return }
	if (emitted + have >= maxrec) { flush(); stop = 1; return }
	flush()
	have = 1; prevkey = key; prevline = line; prevoff = pos; count = 1; pos += len
}
function flush() {
	if (!have) return
	printf "R\t%d\t%d\t%s\n", prevoff, count, substr(prevline, 1, maxbody)
	emitted++; have = 0
	if (dropped != "") { n = split(dropped, d, "\n"); for (i = 1; i < n; i++) printf "D\t%s\n", d[i]; dropped = "" }
}
{ if (NR > 1) handle(buf, buflen); buf = $0; buflen = length($0) + 1 }
END {
	if (NR >= 1) {
		if (!partial) handle(buf, buflen)
		else if (NR == 1 && full) handle(buf, length(buf))
	}
	flush()
	printf "E\t%d\n", pos
}
AWK

# The byte of the first line stamped at or after the boot start (`ms`, and `iso`
# for ISO stamps, which compare as strings).
read -r -d '' FIRST <<'AWK'
$0 ~ /^[0-9]+ / && $1 + 0 >= ms { found = 1; exit }
$0 ~ /^[0-9][0-9-]*T[0-9:.]*Z / && substr($0, 1, 24) >= iso { found = 1; exit }
{ pos += length($0) + 1 }
END { pos += 0; if (pos > size) pos = size; print pos }
AWK

read -r -d '' SCRUB <<'SED'
s/gh[pousr]_[A-Za-z0-9]{20,}/[redacted]/g
s/github_pat_[A-Za-z0-9_]{20,}/[redacted]/g
s/glpat-[A-Za-z0-9_-]{20,}/[redacted]/g
s/npm_[A-Za-z0-9]{30,}/[redacted]/g
s/sk-ant-[A-Za-z0-9_-]{10,}/[redacted]/g
s/sk-(proj-)?[A-Za-z0-9_-]{20,}/[redacted]/g
s/[rs]k_(live|test)_[A-Za-z0-9]{10,}/[redacted]/g
s/xox[abposr]-[A-Za-z0-9-]{10,}/[redacted]/g
s/(AKIA|ASIA)[A-Z0-9]{16}/[redacted]/g
s/eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/[redacted]/g
s#(://)[^/@[:space:]:]+:[^/@[:space:]]+@#\1[redacted]@#g
s#([Bb]earer|[Bb]asic|[Tt]oken) [A-Za-z0-9._~+/=-]{8,}#\1 [redacted]#g
s/([A-Za-z0-9_-]*(token|secret|password|passwd|api[_-]?key|authorization|credential)[A-Za-z0-9_-]*["']?[[:space:]]*[=:][[:space:]]*["']?)[^[:space:]"'&,;}]{4,}/\1[redacted]/Ig
SED

# Records within the hour's budget as a Sentry log item, after one metadata line:
# bytes used, whether the cap is now reached, the offset read to, records kept,
# and the time of the last line read. Times are epoch milliseconds.
read -r -d '' BUILD <<'JQ'
def stamp($l):
	if ($l | test("^[0-9]{13} ")) then ($l[0:13] | tonumber)
	elif ($l | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z ")) then
		(($l[0:19] + "Z") | fromdateiso8601) * 1000
		+ ((($l | capture("^.{19}(?<f>\\.[0-9]+)?").f // "0") | tonumber) * 1000 + 0.5 | floor)
	else null end;
def str($v): {value: $v, type: "string"};
def int($v): {value: $v, type: "integer"};
def common: {
	"log.source": str($src),
	"cloud_workspace.id": str($ws),
	"organization.id": str($org)
};
def record($r; $t):
	([$starts[] | select(. <= $t)] | max) as $boot
	| {
		timestamp: ($t / 1000), trace_id: $trace, level: "info", body: $r.b,
		attributes: (common
			+ {"log.file.offset": int($r.o | tonumber)}
			+ (if $boot == null then {} else {"box.boot_started_at": int($boot)} end)
			+ (if $r.c == "1" then {} else {"log.repeat_count": int($r.c | tonumber)} end))
	};
[inputs] as $lines
| ($lines | map(select(startswith("E\t")))[0][2:] | tonumber) as $read_to
| reduce ($lines[] | select(startswith("R\t") or startswith("D\t"))) as $l
	({items: [], used: $used, over: false, prev: $prev};
	if ($l | startswith("D\t")) then .prev = (stamp($l[2:]) // .prev)
	else
		($l | capture("^R\t(?<o>[0-9]+)\t(?<c>[0-9]+)\t(?<b>.*)$")) as $r
		| (stamp($r.b) // .prev // $now) as $t
		| .prev = $t
		| record($r; $t) as $rec
		| ($rec | tojson | utf8bytelength) as $n
		| if .over or (.used + $n > $cap) then .over = true
		  else .items += [$rec] | .used += $n end
	end)
| if .over and ($capped == "0") then
	.items += [{
		timestamp: ($now / 1000), trace_id: $trace, level: "info",
		body: "log shipper: cap of \($cap) bytes this hour reached; lines are dropped until the next hour",
		attributes: common
	}]
	| .capped = "1"
  else .capped = (if .over then "1" else $capped end) end
| ([.used, .capped, $read_to, (.items | length), (.prev // "")] | @tsv), ({items: .items} | tojson)
JQ

# 0 sent or nothing to send, 1 refused (the pass stops and waits).
send() {
	local body="$1" count="$2" out code wait fails
	out="$(printf '%s\n%s\n%s\n' "{\"dsn\":\"${DSN}\"}" \
		"{\"type\":\"log\",\"item_count\":${count},\"content_type\":\"application/vnd.sentry.items.log+json\"}" "$body" |
		curl -s -o /dev/null -D - -w '%{http_code}' --max-time 15 \
			-H "$AUTH" -H 'Content-Type: application/x-sentry-envelope' --data-binary @- "$ENVELOPE_URL" | tr -d '\r')"
	code="${out##*$'\n'}"
	case "$code" in
		2??) rm -f "${STATE}/retry"; return 0 ;;
		# A batch Sentry cannot parse would be refused forever; it is dropped.
		400 | 413) echo "$(now_ms) logship dropped a batch: ${code}"; return 0 ;;
	esac
	fails="$(read_state retry "0 0" | cut -d' ' -f2)"
	fails=$((fails + 1))
	wait="$(awk -F': *' 'tolower($1) == "retry-after" && $2 ~ /^[0-9]+$/ { print $2; exit }' <<< "$out")"
	if [ -z "$wait" ]; then
		case "$code" in
			401 | 403) wait=$MAX_WAIT_S ;;
			*) wait=$((INTERVAL_S * (1 << (fails < 10 ? fails : 10)))) ;;
		esac
	fi
	[ "$wait" -gt "$MAX_WAIT_S" ] && wait=$MAX_WAIT_S
	write_state retry "$(( $(now_ms) + wait * 1000 )) ${fails}"
	echo "$(now_ms) logship refused: ${code:-none}; waiting ${wait}s"
	return 1
}

ship_file() {
	local src="$1" file="${SUPERSET_LOG_DIR}/${src}.log" size off partial=0 full=0 used capped read_to count last payload
	[ -f "$file" ] || return 0
	size="$(stat -c %s "$file")"
	off="$(read_state "${src}.offset" "")"
	# Turning the shipper on sends no history: each file starts at the current boot.
	if [ -z "$off" ]; then
		off="$size"
		[ -n "$BOOT_MS" ] && off="$(LC_ALL=C awk -v ms="$BOOT_MS" -v iso="$BOOT_ISO" -v size="$size" "$FIRST" "$file")"
	fi
	[ "$size" -lt "$off" ] && off=0
	[ "$size" -eq "$off" ] && { write_state "${src}.offset" "$off"; return 0; }
	tail -c +"$((off + 1))" "$file" | head -c "$MAX_READ" > "${STATE}/chunk"
	[ -n "$(tail -c 1 "${STATE}/chunk")" ] && partial=1
	[ "$(stat -c %s "${STATE}/chunk")" -ge "$MAX_READ" ] && full=1
	{ IFS=$'\t' read -r used capped read_to count last; read -r payload; } < <(
		LC_ALL=C awk -v src="$src" -v pos="$off" -v partial="$partial" -v full="$full" \
			-v maxrec="$MAX_RECORDS" -v maxbody="$MAX_BODY" "$SPLIT" "${STATE}/chunk" |
			LC_ALL=C sed -E "$SCRUB" |
			jq -R -n -r --arg src "$src" --arg ws "${SUPERSET_SANDBOX_WORKSPACE_ID:-}" \
				--arg org "${SUPERSET_SANDBOX_ORGANIZATION_ID:-}" --argjson prev "$(read_state "${src}.time" null)" \
				--arg trace "$TRACE_ID" --argjson now "$NOW" --argjson starts "$BOOT_STARTS" \
				--argjson cap "$CAP" --argjson used "$USED" --arg capped "$CAPPED" "$BUILD"
	)
	[ -n "${read_to:-}" ] || return 0
	if [ "$count" -gt 0 ]; then
		send "$payload" "$count" || return 1
	fi
	USED="$used"; CAPPED="$capped"
	write_state hour "${HOUR} ${USED} ${CAPPED}"
	[ -n "${last:-}" ] && write_state "${src}.time" "$last"
	write_state "${src}.offset" "$read_to"
}

pass() {
	NOW="$(now_ms)"
	local retry_at h
	retry_at="$(read_state retry "0 0" | cut -d' ' -f1)"
	[ "$NOW" -lt "$retry_at" ] && return 0
	HOUR=$((NOW / 3600000))
	read -r h USED CAPPED < <(read_state hour "0 0 0")
	[ "$h" = "$HOUR" ] || { USED=0; CAPPED=0; }
	local src size off idle=1
	for src in "${SOURCES[@]}"; do
		size="$(stat -c %s "${SUPERSET_LOG_DIR}/${src}.log" 2>/dev/null)" || continue
		off="$(read_state "${src}.offset" "")"
		[ "$size" = "$off" ] || { idle=0; break; }
	done
	[ "$idle" = 1 ] && return 0
	read_boots
	for src in "${SOURCES[@]}"; do
		ship_file "$src" || break
	done
	rm -f "${STATE}/chunk"
}

read_boots() {
	BOOT_STARTS="$(grep -oE '^[0-9]+ boot\.start' "$SUPERSET_BOOT_LOG" 2>/dev/null | cut -d' ' -f1 | jq -sc .)"
	BOOT_MS="$(jq -r '.[-1] // ""' <<< "$BOOT_STARTS")"
	BOOT_ISO=""
	[ -n "$BOOT_MS" ] && BOOT_ISO="$(date -u -d "@$((BOOT_MS / 1000))" +%Y-%m-%dT%H:%M:%S).$(printf '%03d' $((BOOT_MS % 1000)))Z"
}

# Offsets saved in a boot this script did not run in (the flag was off, or an older
# runner left the state behind) would send what that boot wrote; start again.
read_boots
if [ "$(read_state boot "")" != "${BOOT_MS:-}" ] &&
	[ "$(read_state boot "")" != "$(jq -r '.[-2] // "none"' <<< "$BOOT_STARTS")" ]; then
	rm -f "${STATE}"/*.offset "${STATE}"/*.time
fi
write_state boot "${BOOT_MS:-}"

[ "${1:-}" = --once ] && { pass; exit 0; }
while true; do
	pass
	sleep "$INTERVAL_S"
done
