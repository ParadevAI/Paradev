{
	"name": "@superset/chats-runner",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Runs inside a Dev's box: serves its turns and streams them, with pi as the agent.",
	"scripts": {
		"build": "bun build.ts",
		"image:build": "bun build.ts && docker build -t paradev-dev-box:dev .",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"test": "bun test"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.8.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@earendil-works/pi-mcp": "1.1.0",
		"jose": "6.2.13",
		"typebox": "1.3.27",
		"ws": "8.21.3"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"@types/ws": "8.18.1",
		"bun-types": "1.4.3",
		"typescript": "7.0.2"
	}
}
