+#pragma mark - Superset interactive push
+
+- (void)armInteractivePush
+{
+  _interactivePushArmed = YES;
+  _interactivePushProgress = 0;
+  _interactivePushOutcome = 0;
+  NSUInteger generation = ++_interactivePushGeneration;
+  // The push comes from JS after this call. If it never comes, do not take over a later push.
+  __weak RNSScreenStackView *weakSelf = self;
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+    RNSScreenStackView *strongSelf = weakSelf;
+    if (strongSelf != nil && strongSelf->_interactivePushGeneration == generation) {
+      strongSelf->_interactivePushArmed = NO;
+    }
+  });
+}
+
+- (void)updateInteractivePush:(double)progress
+{
+  _interactivePushProgress = progress;
+  if (_interactivePushRunning) {
+    [_interactionController updateInteractiveTransition:progress];
+  }
+}
+
+- (void)endInteractivePush:(BOOL)finish
+{
+  if (_interactivePushRunning) {
+    [self completeInteractivePush:finish];
+  } else if (_interactivePushArmed || _interactivePushStarted) {
+    _interactivePushOutcome = finish ? 1 : -1;
+  }
+}
+
+- (void)startInteractivePush
+{
+  _interactivePushArmed = NO;
+  _interactivePushStarted = YES;
+  _interactionController = [RNSPercentDrivenInteractiveTransition new];
+  __weak RNSScreenStackView *weakSelf = self;
+  // The finger moved before JS pushed the screen, so start where it is now.
+  _interactionController.onStart = ^{
+    RNSScreenStackView *strongSelf = weakSelf;
+    if (strongSelf == nil || !strongSelf->_interactivePushStarted) {
+      return;
+    }
+    strongSelf->_interactivePushRunning = YES;
+    [strongSelf->_interactionController updateInteractiveTransition:strongSelf->_interactivePushProgress];
+    if (strongSelf->_interactivePushOutcome != 0) {
+      BOOL finish = strongSelf->_interactivePushOutcome > 0;
+      dispatch_async(dispatch_get_main_queue(), ^{
+        [weakSelf completeInteractivePush:finish];
+      });
+    }
+  };
+}
+
+- (void)completeInteractivePush:(BOOL)finish
+{
+  if (!_interactivePushRunning) {
+    return;
+  }
+  // A cancelled push removes the screen from UIKit. RNSScreen then sends onDismissed, so JS drops the route.
+  if (finish) {
+    [_interactionController finishInteractiveTransition];
+  } else {
+    [_interactionController cancelInteractiveTransition];
+  }
+  _interactionController = nil;
+  _interactivePushStarted = NO;
+  _interactivePushRunning = NO;
+  _interactivePushOutcome = 0;
+}
